# 공통
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# 프론트와 백엔드를 같은 도메인의 Nginx에서 제공하면 VITE_API_BASE_URL은 /api로 둡니다.
VITE_API_BASE_URL=/api
HTTP_PORT=80
HTTPS_PORT=443

# 인증서를 발급받을 도메인. nginx 설정에 그대로 들어가므로 http:// 없이 호스트만 씁니다.
# 이 값의 DNS가 서버를 가리키고 있어야 scripts/init-letsencrypt.sh가 성공합니다.
DOMAIN=your-domain.com
# 갱신 실패 시 만료 경고를 받을 주소. 비워 두면 알림 없이 등록됩니다.
LETSENCRYPT_EMAIL=

# CORS는 프론트가 다른 도메인/포트에서 뜰 때만 필요합니다.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.com

# localhost에서 먼저 확인하려면 false, 실제 HTTPS 배포에서는 true로 바꿉니다.
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_USE_X_FORWARDED_PROTO=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# 인증 엔드포인트 요청 제한 (무차별 대입, 재설정 메일 남용 방지)
# NUM_PROXIES는 Django 앞단의 프록시 수입니다. 이 저장소의 nginx 구성은 1입니다.
NUM_PROXIES=1
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=5/hour

# PostgreSQL
POSTGRES_DB=home_inventory
POSTGRES_USER=home_inventory
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 정적 파일/업로드 파일
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# Gunicorn
GUNICORN_WORKERS=3

# 비밀번호 찾기 이메일
# 개발 중에는 console backend를 쓰면 서버 로그에 인증 코드가 찍힙니다.
# 실제 운영에서는 Gmail, AWS SES, Mailgun 같은 SMTP 정보를 입력하세요.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@example.com
